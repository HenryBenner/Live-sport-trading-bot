# WebSocket server
CONTROL_TOKEN=change_me_to_a_long_random_secret
# With Tailscale, use the VPS Tailscale IP or 0.0.0.0 plus an AWS security
# group that does not expose port 8765 publicly.
WS_HOST=0.0.0.0
WS_PORT=8765

# Persistent event-session controls and append-only command/trade audit log.
RUNTIME_STATE_PATH=config/runtime_state.json
AUDIT_LOG_PATH=logs/commands.jsonl

# All-in cost caps include filled contract cost plus reported Kalshi fees.
# Blank means infinite. The market cap applies independently to every buy key.
DEFAULT_MARKET_COST_CAP_DOLLARS=
EVENT_COST_CAP_DOLLARS=

# The bot reserves this amount before sending orders so reported fees remain
# inside the all-in cap. Increase these values for a more conservative reserve.
ALL_IN_FEE_RESERVE_RATE=0.10
ALL_IN_FEE_RESERVE_DOLLARS=0.25

# Kalshi
# Use demo first.
KALSHI_ENV=demo

# Production:
# KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
# Demo:
# KALSHI_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2

KALSHI_API_KEY_ID=your_api_key_id_here
# Paste the complete private key on one line with literal \n separators.
# Keep the single quotes so both systemd and python-dotenv preserve the backslashes.
KALSHI_PRIVATE_KEY_PEM='-----BEGIN PRIVATE KEY-----\nPASTE_KEY_BODY_HERE\n-----END PRIVATE KEY-----'
KALSHI_SUBACCOUNT=0
KALSHI_EXCHANGE_INDEX=0
